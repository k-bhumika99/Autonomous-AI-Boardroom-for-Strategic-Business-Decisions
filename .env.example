# Get a free key from https://aistudio.google.com/apikey and paste it below.
# The app WILL NOT WORK and every agent page will show "could not complete"
# until this is set to a real key.
GEMINI_API_KEY=
# gemini-2.0-flash was retired by Google on 1 June 2026. Use gemini-2.5-flash
# (current stable GA model) or check https://ai.google.dev/gemini-api/docs/models
# for the latest recommended model if this one is later deprecated too.
GEMINI_MODEL=gemini-2.5-flash
SECRET_KEY=change-this-to-a-random-secret-in-production
